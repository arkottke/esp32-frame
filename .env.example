# Copy to .env and fill in your values.
# Used by `make provision` in firmware/ to write WiFi credentials and server
# config directly to the device's NVS partition — no captive portal needed.

FRAME_WIFI_SSID=
FRAME_WIFI_PASSWORD=
FRAME_SERVER_URL=http://192.168.50.106:8000
FRAME_POLL_SECONDS=300

# Telegram bot (server/telegram_bot.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GALLERY_DIR=            # defaults to server/telegram-gallery/
TELEGRAM_ALLOWED_CHAT_ID=        # optional; leave blank to accept from any chat
